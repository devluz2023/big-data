{
  "name": "orcamentario",
  "version": "0.0.1",
  "description": "Sistema Orçamentário com MySQL",
  "keywords": [
    "loopback-application",
    "loopback"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "lb-tsc",
    "build:watch": "lb-tsc --watch",
    "lint": "npm run eslint && npm run prettier:check",
    "lint:fix": "npm run eslint:fix",
    "prettier:cli": "lb-prettier \"src/**/*.ts\"",
    "prettier:check": "npm run prettier:cli --check",
    "prettier:fix": "npm run prettier:cli --write",
    "eslint": "lb-eslint --src/src",
    "eslint:fix": "npm run eslint -- --fix",
    "pretest": "npm run rebuild",
    "test": "lb-mocha --allow-uncaught \"dist/__tests__/**/*.js\"",
    "test:dev": "lb-mocha --watch dist/__tests__/**/*.js",
    "prestart": "npm run build",
    "start": "node -r source-map-support/register .",
    "clean": "lb-clean dist *.tsbuildinfo .eslintcache",
    "rebuild": "npm run clean && npm run build"
  },
  "dependencies": {
    "@loopback/boot": "^3.0.1",
    "@loopback/core": "^2.10.1",
    "@loopback/repository": "^3.0.1",
    "@loopback/rest": "^7.0.1",
    "@loopback/rest-explorer": "^3.0.1",
    "@loopback/service-proxy": "^3.0.1",
    "loopback-connector-mysql": "^5.4.0",
    "tslib": "^2.0.0"
  },
  "devDependencies": {
    "@loopback/build": "^6.2.4",
    "@loopback/eslint-config": "^10.0.0",
    "@loopback/testlab": "^3.2.6",
    "@types/express": "^4.17.25",
    "@types/node": "^10.17.35",
    "eslint": "^7.9.0",
    "source-map-support": "^0.5.19",
    "typescript": "~4.0.2"
  },
  "overrides": {
    "uuid": "8.3.2"
  }
}
