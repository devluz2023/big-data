cat << 'EOF' > .gitignore
# Ambientes virtuais e Python
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.venv/
env/

# Volumes de dados do Docker (Locais)
postgres_data/
es_data/
kafka_data/
zookeeper_data/
warehouse/

# Arquivos do Sistema Operacional
.DS_Store
.Spotlight-V100
.Trashes
EOF

# Dependências
node_modules/
jspm_packages/

# Build e arquivos gerados pelo TypeScript
dist/
build/
*.tsbuildinfo

# Variáveis de ambiente e segredos locais
.env
.env.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cobertura de testes e relatórios
coverage/
.nyc_output/

# Sistema operacional e IDEs
.DS_Store
.Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace